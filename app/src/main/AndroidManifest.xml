<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:name=".app.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="DroidMaker"
        android:largeHeap="true"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".app.ProjectActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".app.SpriteEditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".app.SoundEditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".app.ScriptEditorActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".app.ObjectEditorActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".app.RoomEditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".app.SettingsActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".app.ReferenceActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".run.RunnerActivity"
            android:theme="@style/GameTheme"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|uiMode" />
    </application>
</manifest>
